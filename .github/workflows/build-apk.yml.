
name: BotWAndroid APK

on:
  workflow_dispatch:
  push:
    paths:
      - "*.zip"

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar arquivos do repositório
        uses: actions/checkout@v4

      - name: Configurar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Configurar Android SDK
        uses: android-actions/setup-android@v3

      - name: Instalar ferramentas Android
        run: |
          sdkmanager "platforms;android-35" "build-tools;35.0.0" "ndk;27.2.12479018" "cmake;3.22.1"

      - name: Configurar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"

      - name: Extrair projeto
        run: |
          mkdir -p projeto
          unzip -o "$(find . -maxdepth 1 -name '*.zip' | head -n 1)" -d projeto
          find projeto -name settings.gradle.kts -print

      - name: Compilar APK
        run: |
          DIR="$(dirname "$(find projeto -name settings.gradle.kts -print -quit)")"
          cd "$DIR"
          gradle --no-daemon assembleDebug

      - name: Disponibilizar APK
        uses: actions/upload-artifact@v4
        with:
          name: BotWAndroid-debug-apk
          path: projeto/**/app/build/outputs/apk/debug/app-debug.apk
